# Copy this file to .env only on the server. Do not commit .env.
# Generate different long random values for the password fields.

DB_NAME=feedback_process
DB_USER=feedback_user
DB_PASSWORD=replace_with_a_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_root_password
JWT_SECRET=replace_with_a_long_random_jwt_secret

# This must be the exact staging URL while team testing.
FRONTEND_ORIGIN=https://feedback-process-staging.justuju.in

# Optional integrations. Leave blank if an integration is not yet configured.
MATTERMOST_WEBHOOK_URL=
SC_MATTERMOST_WEBHOOK_URL=

# Shared sender account for all password-reset and reminder emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
